{
  "name": "verb-nurbs-ts",
  "version": "4.0.0-alpha.0",
  "author": "pboyer <peter.b.boyer@gmail.com>",
  "description": "A TypeScript NURBS library for curves, surfaces and generative design (a TypeScript port of verb)",
  "repository": {
    "type": "git",
    "url": "https://github.com/smor/verb-nurbs-ts.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "layers": "node scripts/check-layers.mjs",
    "lint": "eslint . --max-warnings $npm_package_config_maxLintWarnings",
    "test": "npm run build && mocha",
    "test:fast": "mocha",
    "coverage": "npm run build && c8 --check-coverage --lines 95 --branches 89 --functions 91 --reporter=text-summary --reporter=html --reporter=lcov --include 'src/**' --exclude-after-remap mocha",
    "docs": "typedoc",
    "check": "npm run typecheck && npm run layers && npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks || true",
    "demo:vessel": "npm run build && node examples/aalto-vessel.mjs",
    "demo:sweeps": "npm run build && node examples/swept-objects.mjs",
    "demo:booleans": "npm run build && node examples/boolean-objects.mjs",
    "demo:step": "npm run build && node examples/step-export.mjs",
    "playground": "node playground/build.mjs",
    "viewer": "node viewer/build.mjs",
    "ratchets": "node scripts/check-ratchets.mjs"
  },
  "keywords": [
    "NURBS",
    "geometry",
    "cad",
    "surface",
    "curve",
    "spline",
    "mesh"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.7",
    "@types/three": "^0.187.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "manifold-3d": "^3.5.5",
    "mocha": "^10.6.0",
    "should": "^13.2.3",
    "three": "^0.187.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "cdt2d": "^1.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "config": {
    "maxLintWarnings": 60
  }
}
