{
  "name": "verb-nurbs-ts",
  "version": "4.0.0-alpha.0",
  "author": "pboyer <peter.b.boyer@gmail.com>",
  "description": "A TypeScript NURBS library for curves, surfaces and generative design (a TypeScript port of verb)",
  "repository": {
    "type": "git",
    "url": "https://github.com/smor/verb-nurbs-ts.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && mocha",
    "typecheck": "tsc --noEmit -p ."
  },
  "keywords": [
    "NURBS",
    "geometry",
    "cad",
    "surface",
    "curve",
    "spline",
    "mesh"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "devDependencies": {
    "@types/node": "^26.6.7",
    "mocha": "^10.6.0",
    "should": "^13.2.3",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
