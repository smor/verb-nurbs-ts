{
  "flywheel": {
    "version": 1,
    "parameters": {
      "crank": 20,
      "rod": 72,
      "flywheelRadius": 35,
      "thick": 6,
      "pinR": 2.5,
      "clearance": 0.2
    },
    "features": {
      "disc": {
        "type": "cylinder",
        "from": [
          0,
          0,
          0
        ],
        "to": [
          0,
          0,
          "thick"
        ],
        "radius": "flywheelRadius"
      },
      "boreShape": {
        "type": "cylinder",
        "from": [
          0,
          0,
          0
        ],
        "to": [
          0,
          0,
          "(thick + 2)"
        ],
        "radius": "(pinR + clearance)"
      },
      "bore": {
        "type": "transform",
        "of": "boreShape",
        "translate": [
          0,
          0,
          -1
        ]
      },
      "wheel": {
        "type": "difference",
        "from": "disc",
        "minus": [
          "bore"
        ]
      },
      "pinShape": {
        "type": "cylinder",
        "from": [
          0,
          0,
          0
        ],
        "to": [
          0,
          0,
          9
        ],
        "radius": "pinR"
      },
      "pin": {
        "type": "transform",
        "of": "pinShape",
        "translate": [
          "crank",
          0,
          "(thick - 1)"
        ]
      },
      "flywheel": {
        "type": "union",
        "of": [
          "wheel",
          "pin"
        ]
      },
      "barShape": {
        "type": "box",
        "min": [
          "-(((rod + 12)) / 2)",
          -5,
          0
        ],
        "max": [
          "((rod + 12)) / 2",
          5,
          4
        ]
      },
      "bar": {
        "type": "transform",
        "of": "barShape",
        "translate": [
          "(rod / 2)",
          0,
          0
        ]
      },
      "eyeShape": {
        "type": "cylinder",
        "from": [
          0,
          0,
          0
        ],
        "to": [
          0,
          0,
          6
        ],
        "radius": "(pinR + clearance)"
      },
      "eyeA": {
        "type": "transform",
        "of": "eyeShape",
        "translate": [
          0,
          0,
          -1
        ]
      },
      "eyeB": {
        "type": "transform",
        "of": "eyeShape",
        "translate": [
          "rod",
          0,
          -1
        ]
      },
      "eyes": {
        "type": "union",
        "of": [
          "eyeA",
          "eyeB"
        ]
      },
      "connectingRod": {
        "type": "difference",
        "from": "bar",
        "minus": [
          "eyes"
        ]
      }
    },
    "output": "flywheel",
    "machine": "fdm"
  },
