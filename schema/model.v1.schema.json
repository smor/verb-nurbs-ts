{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smor/verb-nurbs-ts/schema/model.v1.schema.json",
  "title": "verb-nurbs-ts model document, version 1",
  "description": "Parameters and features regenerated into one solid with persistent face names (docs/formats.md, docs/model.md). Lengths in millimetres, angles in degrees. Written by hand from ModelDocument in src/model/Model.ts; a test checks every fixture and every compiled graph against it.",
  "type": "object",
  "required": ["version", "features", "output"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "parameters": { "type": "object", "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/value" } },
    "features": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/feature" } },
    "output": { "$ref": "#/$defs/id" },
    "machine": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/machine" } ] },
    "certify": { "type": "boolean" }
  },
  "$defs": {
    "name": { "description": "a parameter's name, as expressions write it", "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "id": { "description": "a feature's id: the first part of its faces' names, so without the characters names and patterns use", "type": "string", "pattern": "^[^.|*,@\\s]+$" },
    "value": { "description": "a number, or an expression over the parameters", "type": ["number", "string"] },
    "point": { "type": "array", "items": { "$ref": "#/$defs/value" }, "minItems": 3, "maxItems": 3 },
    "pair": { "type": "array", "items": { "$ref": "#/$defs/value" }, "minItems": 2, "maxItems": 2 },
    "patterns": { "type": "array", "items": { "type": "string" } },
    "machine": {
      "type": "object", "required": ["name", "buildVolume", "minWall"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "buildVolume": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "minWall": { "type": "number" },
        "drains": { "type": "boolean" },
        "overhang": { "type": "number" },
        "draft": { "type": "number" }
      }
    },
    "feature": {
      "type": "object", "required": ["type"],
      "properties": { "type": { "enum": ["box", "cylinder", "pipe", "revolve", "prism", "primitive", "transform", "union", "intersection", "difference", "choose", "round", "shell", "lattice"] } },
      "allOf": [
        { "if": { "properties": { "type": { "const": "box" } } }, "then": { "$ref": "#/$defs/box" } },
        { "if": { "properties": { "type": { "const": "cylinder" } } }, "then": { "$ref": "#/$defs/cylinder" } },
        { "if": { "properties": { "type": { "const": "pipe" } } }, "then": { "$ref": "#/$defs/pipe" } },
        { "if": { "properties": { "type": { "const": "revolve" } } }, "then": { "$ref": "#/$defs/revolve" } },
        { "if": { "properties": { "type": { "const": "prism" } } }, "then": { "$ref": "#/$defs/prism" } },
        { "if": { "properties": { "type": { "const": "primitive" } } }, "then": { "$ref": "#/$defs/primitive" } },
        { "if": { "properties": { "type": { "const": "transform" } } }, "then": { "$ref": "#/$defs/transform" } },
        { "if": { "properties": { "type": { "enum": ["union", "intersection"] } } }, "then": { "$ref": "#/$defs/boolean" } },
        { "if": { "properties": { "type": { "const": "difference" } } }, "then": { "$ref": "#/$defs/difference" } },
        { "if": { "properties": { "type": { "const": "choose" } } }, "then": { "$ref": "#/$defs/choose" } },
        { "if": { "properties": { "type": { "const": "round" } } }, "then": { "$ref": "#/$defs/round" } },
        { "if": { "properties": { "type": { "const": "shell" } } }, "then": { "$ref": "#/$defs/shell" } },
        { "if": { "properties": { "type": { "const": "lattice" } } }, "then": { "$ref": "#/$defs/lattice" } }
      ]
    },
    "box": { "type": "object", "required": ["type", "min", "max"], "additionalProperties": false,
      "properties": { "type": true, "min": { "$ref": "#/$defs/point" }, "max": { "$ref": "#/$defs/point" }, "divs": { "$ref": "#/$defs/value" } } },
    "cylinder": { "type": "object", "required": ["type", "from", "to", "radius"], "additionalProperties": false,
      "properties": { "type": true, "from": { "$ref": "#/$defs/point" }, "to": { "$ref": "#/$defs/point" }, "radius": { "$ref": "#/$defs/value" }, "divs": { "$ref": "#/$defs/pair" } } },
    "pipe": { "type": "object", "required": ["type", "through", "radius"], "additionalProperties": false,
      "properties": { "type": true, "through": { "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 2 }, "radius": { "$ref": "#/$defs/value" }, "divs": { "$ref": "#/$defs/pair" } } },
    "revolve": { "type": "object", "required": ["type", "profile"], "additionalProperties": false,
      "properties": { "type": true, "profile": { "type": "array", "items": { "$ref": "#/$defs/pair" }, "minItems": 2 }, "divs": { "$ref": "#/$defs/pair" } } },
    "prism": { "type": "object", "required": ["type", "outline", "height"], "additionalProperties": false,
      "properties": { "type": true, "outline": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/value" }, "minItems": 2, "maxItems": 3 }, "minItems": 3,
          "description": "points [x, y] or [x, y, r] in the plane z = 0; r rounds that corner" },
        "height": { "$ref": "#/$defs/value" }, "center": { "$ref": "#/$defs/pair" } } },
    "primitive": { "type": "object", "required": ["type", "shape"], "additionalProperties": false,
      "properties": { "type": true, "shape": { "type": "string", "description": "a catalogue name (docs/primitives.md)" },
        "values": { "type": "object", "description": "parameters by catalogue name; angles in degrees", "additionalProperties": { "$ref": "#/$defs/value" } } } },
    "transform": { "type": "object", "required": ["type", "of"], "additionalProperties": false,
      "properties": { "type": true, "of": { "$ref": "#/$defs/id" },
        "scale": { "anyOf": [ { "$ref": "#/$defs/value" }, { "$ref": "#/$defs/point" } ] },
        "rotate": { "type": "object", "required": ["axis", "degrees"], "additionalProperties": false,
          "properties": { "axis": { "$ref": "#/$defs/point" }, "degrees": { "$ref": "#/$defs/value" }, "about": { "$ref": "#/$defs/point" } } },
        "translate": { "$ref": "#/$defs/point" } } },
    "boolean": { "type": "object", "required": ["type", "of"], "additionalProperties": false,
      "properties": { "type": true, "of": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1 } } },
    "difference": { "type": "object", "required": ["type", "from", "minus"], "additionalProperties": false,
      "properties": { "type": true, "from": { "$ref": "#/$defs/id" }, "minus": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
    "choose": { "type": "object", "required": ["type", "when"], "additionalProperties": false,
      "description": "A switch: then where when is not 0, else where it is; either may be left out, for nothing",
      "properties": { "type": true, "when": { "$ref": "#/$defs/value" }, "then": { "$ref": "#/$defs/id" }, "else": { "$ref": "#/$defs/id" } } },
    "round": { "type": "object", "required": ["type", "of", "rules"], "additionalProperties": false,
      "properties": { "type": true, "of": { "$ref": "#/$defs/id" },
        "rules": { "type": "array", "items": { "type": "object", "required": ["edges", "radius"], "additionalProperties": false,
          "properties": { "edges": { "type": "string" }, "radius": { "$ref": "#/$defs/value" } } } },
        "shape": { "enum": ["circular", "curvature", "chamfer"] }, "corner": { "enum": ["auto", "ball"] } } },
    "shell": { "type": "object", "required": ["type", "of", "thickness"], "additionalProperties": false,
      "properties": { "type": true, "of": { "$ref": "#/$defs/id" }, "thickness": { "$ref": "#/$defs/value" }, "open": { "$ref": "#/$defs/patterns" } } },
    "lattice": { "type": "object", "required": ["type", "of", "pattern", "cell", "wall"], "additionalProperties": false,
      "properties": { "type": true, "of": { "$ref": "#/$defs/id" }, "pattern": { "enum": ["gyroid", "schwarz-p", "diamond", "bcc", "octet", "cubic"] },
        "cell": { "$ref": "#/$defs/value" }, "wall": { "$ref": "#/$defs/value" }, "skin": { "$ref": "#/$defs/value" }, "blend": { "$ref": "#/$defs/value" },
        "size": { "$ref": "#/$defs/value" }, "grade": { "type": "object", "required": ["axis", "to"], "additionalProperties": false,
          "properties": { "axis": { "enum": ["x", "y", "z"] }, "to": { "$ref": "#/$defs/value" } } },
        "open": { "$ref": "#/$defs/patterns" } } }
  }
}
