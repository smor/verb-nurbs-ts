{
  "version": 2,
  "meta": {
    "name": "Vine column",
    "description": "A swelling shaft wound by three helical vines that leave it where it narrows, between a flared base and capital: Gaudí-like"
  },
  "nodes": {
    "h": {
      "type": "number",
      "in": {
        "value": 140
      },
      "label": "Height"
    },
    "r": {
      "type": "number",
      "in": {
        "value": 10
      },
      "label": "Shaft radius"
    },
    "turns": {
      "type": "number",
      "in": {
        "value": 1.5
      },
      "label": "Turns"
    },
    "vine": {
      "type": "number",
      "in": {
        "value": 2.6
      },
      "label": "Vine radius"
    },
    "shaft": {
      "type": "freeform/revolve",
      "label": "Shaft, base and capital",
      "in": {
        "radius": "r * (1 + 0.5 * pow(2 * t - 1, 2)) + 1.2 * r * exp(-pow(t / 0.07, 2)) + 1.5 * r * exp(-pow((1 - t) / 0.09, 2))",
        "height": "@h",
        "samples": 32
      }
    },
    "v1": {
      "type": "freeform/pipe",
      "label": "Vine",
      "in": {
        "x": "(r * 1.4) * cos(2 * pi * turns * t)",
        "y": "(r * 1.4) * sin(2 * pi * turns * t)",
        "z": "h * (0.05 + 0.9 * t)",
        "radius": "@vine",
        "samples": 30
      }
    },
    "v2": {
      "type": "transform/rotate",
      "in": {
        "of": "@v1",
        "axis": "z",
        "degrees": 120
      },
      "label": "Vine, turned"
    },
    "v3": {
      "type": "transform/rotate",
      "in": {
        "of": "@v1",
        "axis": "z",
        "degrees": -120
      },
      "label": "Vine, turned back"
    },
    "a": {
      "type": "boolean/union",
      "in": {
        "a": "@v1",
        "b": "@v2"
      }
    },
    "vines": {
      "type": "boolean/union",
      "in": {
        "a": "@a",
        "b": "@v3"
      },
      "label": "Three vines"
    },
    "column": {
      "type": "boolean/union",
      "in": {
        "a": "@shaft",
        "b": "@vines"
      }
    }
  },
  "outputs": {
    "column": "@column"
  },
  "view": {
    "nodes": {
      "h": {
        "x": 0,
        "y": 0
      },
      "r": {
        "x": 0,
        "y": 230
      },
      "turns": {
        "x": 0,
        "y": 460
      },
      "vine": {
        "x": 0,
        "y": 690
      },
      "shaft": {
        "x": 300,
        "y": 0
      },
      "v1": {
        "x": 300,
        "y": 230
      },
      "v2": {
        "x": 300,
        "y": 460
      },
      "v3": {
        "x": 300,
        "y": 690
      },
      "a": {
        "x": 600,
        "y": 0
      },
      "vines": {
        "x": 600,
        "y": 230
      },
      "column": {
        "x": 900,
        "y": 0
      }
    }
  }
}
